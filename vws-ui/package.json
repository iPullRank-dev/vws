{
  "name": "vws-ui",
  "private": true,
  "version": "1.0.0",
  "description": "VWS: vector analysis workstation for relevance engineers",
  "author": "iPullRank",
  "license": "Apache-2.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "fetch-python": "node scripts/fetch-python.mjs",
    "dist": "npm run build && node scripts/fetch-python.mjs && electron-builder --win",
    "dist:dir": "npm run build && node scripts/fetch-python.mjs && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.ipullrank.vws",
    "productName": "VWS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/python",
        "to": "python"
      },
      {
        "from": "../vws-backend",
        "to": "backend",
        "filter": [
          "main.py",
          "setup_runtime.py",
          "requirements.txt",
          "constraints.txt",
          "services/*.py"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VWS",
      "include": "installer/vws.nsh"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/plotly.js": "^2.29.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "axios": "^1.6.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "lucide-react": "^0.300.0",
    "plotly.js": "^2.35.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.25.0",
    "react-force-graph-3d": "^1.29.1",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.20.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.15.5"
  }
}
